---
/**
 * AdaptationComparison — "What does pretraining buy on a new robot body?"
 * Two interactive charts rendered from verified measurement artifacts
 * (src/data/adaptation-results.json, generated by scripts/export_adaptation_data.py):
 *
 *  1. Seen embodiments — transfer SSIM vs training progress, MiX-World init
 *     vs Wan init, one family selected at a time (chips).
 *  2. Unseen embodiments — matched-budget PSNR gain (dB) bars per embodiment,
 *     hover tooltips expose the underlying Wan/MiX-World pair; one-shot budget
 *     is flagged.
 *
 * Site palette: warm white bg, ink text, brand orange for MiX-World, muted
 * gray for Wan. No chart libraries — hand-rolled SVG, small footprint.
 */
import results from "../data/adaptation-results.json";
import site from "../data/site.json";
const { adaptation } = site;
---

<div class="adapt-charts" data-adapt>
  <script
    type="application/json"
    data-adapt-data
    set:html={JSON.stringify(results)}
  />

  {/* ---- chart 1: seen embodiments, transfer SSIM curves ---- */}
  <div class="chart-card">
    <div class="chart-card__head">
      <h3 class="chart-card__title">{adaptation.seen_title}</h3>
      <div class="chip-row" role="tablist" aria-label="Embodiment family" data-seen-chips>
        {
          results.seen.map((f, i) => (
            <button
              type="button"
              class={`chip${i === 0 ? " is-active" : ""}`}
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
              data-seen-chip={f.id}
            >
              {f.label}
            </button>
          ))
        }
      </div>
    </div>
    <div class="chart-holder">
      <svg
        class="adapt-svg"
        data-seen-svg
        viewBox="0 0 560 320"
        role="img"
        aria-label="Prediction SSIM versus training progress for MiX-World and Wan initialization"
      />
    </div>
    <div class="chart-card__footer">
      <div class="legend">
        <span class="legend__item"><span class="swatch swatch--mix" />MiX-World init</span>
        <span class="legend__item"><span class="swatch swatch--wan" />Wan init</span>
      </div>
      <p class="chart-note" data-seen-meta />
    </div>
  </div>

  {/* ---- chart 2: unseen embodiments, PSNR gain bars ---- */}
  <div class="chart-card">
    <div class="chart-card__head">
      <h3 class="chart-card__title">{adaptation.unseen_title}</h3>
      <div class="legend legend--chips" data-unseen-chips>
        {
          results.unseen.map((u, i) => (
            <button
              type="button"
              class={`chip chip--legend${i === 0 ? " is-active" : ""}`}
              data-unseen-chip={u.id}
              aria-pressed="false"
            >
              <span class="dot" style={`background:${u.color}`} />
              {u.label}
            </button>
          ))
        }
      </div>
    </div>
    <div class="chart-holder">
      <svg
        class="adapt-svg"
        data-unseen-svg
        viewBox="0 0 560 320"
        role="img"
        aria-label="PSNR gain of MiX-World initialization over Wan initialization at matched fine-tuning budgets"
      />
    </div>
    <div class="chart-card__footer">
      <p class="chart-metric">{adaptation.chart_note}</p>
      <p class="chart-note"><span class="one-shot-label">One-shot</span>{" "}{adaptation.one_shot_note}</p>
    </div>
  </div>

  <div class="adapt-tooltip" data-adapt-tooltip hidden />
</div>

<style>
  .adapt-charts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    position: relative;
  }

  .chart-card {
    background: var(--color-surface);
    border: var(--border-hairline);
    border-radius: var(--radius-media);
    padding: var(--space-3);
    display: grid;
    grid-template-rows: auto auto 1fr;
  }

  .chart-card__footer {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    border-top: var(--border-hairline);
    margin-top: var(--space-2);
    padding-top: var(--space-2);
  }

  .chart-metric { margin: 0; font-size: 0.8125rem; color: var(--color-text-secondary); }
  .one-shot-label { font-weight: 600; margin-right: 0.5rem; color: var(--color-text); }

  .chart-card__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: var(--space-2);
  }

  .chart-card__title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    margin: 0;
  }

  .chip-row,
  .legend--chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .chip {
    appearance: none;
    border: var(--border-hairline);
    background: transparent;
    border-radius: var(--radius-pill);
    color: var(--color-text-secondary);
    font: inherit;
    font-size: 0.6875rem;
    padding: 0.18rem 0.6rem;
    cursor: pointer;
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .chip:hover {
    color: var(--color-text);
  }

  .chip.is-active {
    background: var(--color-pill-ink);
    border-color: var(--color-pill-ink);
    color: var(--color-pill-ink-text);
    font-weight: 600;
  }

  .chip--legend .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 5px;
    vertical-align: 1px;
  }

  .chart-holder {
    background: var(--color-bg);
    border-radius: var(--radius-md);
    padding: var(--space-2);
  }

  .adapt-svg {
    display: block;
    width: 100%;
    height: auto;
    text-rendering: geometricPrecision;
    -webkit-font-smoothing: antialiased;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    margin: 0;
  }

  .legend__item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .swatch {
    display: inline-block;
    width: 18px;
    height: 0;
    border-top: 3px solid;
  }

  .swatch--mix {
    border-color: var(--color-accent);
  }

  .swatch--wan {
    border-color: #9a948a;
  }

  .chart-note {
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    line-height: 1.6;
    margin: 0;
  }

  .adapt-tooltip {
    position: fixed;
    z-index: 80;
    max-width: 260px;
    background: rgba(20, 18, 15, 0.94);
    color: #fff;
    font-size: 0.75rem;
    line-height: 1.45;
    border-radius: var(--radius-md);
    padding: 8px 10px;
    pointer-events: none;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.25);
  }

  .adapt-tooltip .tt-title {
    font-weight: 600;
    margin-bottom: 2px;
  }

  .adapt-tooltip .tt-dim {
    color: rgba(255, 255, 255, 0.72);
  }

  .adapt-tooltip .tt-badge {
    display: inline-block;
    background: var(--color-accent);
    color: #201c14;
    border-radius: 999px;
    font-size: 0.625rem;
    font-weight: 700;
    padding: 0 6px;
    margin-left: 4px;
    vertical-align: 1px;
  }




  .text-block {
    margin-top: var(--space-2);
  }

  /* svg element states */
  .adapt-svg :global(.axis-line) {
    stroke: var(--color-border-strong);
    stroke-width: 1;
  }

  .adapt-svg :global(.grid-line) {
    stroke: var(--color-border);
    stroke-width: 1;
    stroke-dasharray: 2, 3;
  }

  .adapt-svg :global(.axis-text) {
    font-size: 13px;
    fill: var(--color-text-secondary);
    font-family: var(--font-sans);
    font-weight: 500;
  }

  .adapt-svg :global(.bar-value) {
    font-size: 13px;
    font-weight: 700;
    fill: var(--color-text);
    font-family: var(--font-sans);
  }

  .adapt-svg :global(.bar-rect) {
    transform-box: fill-box;
    transform-origin: bottom;
    transform: scaleY(0);
    transition: transform 900ms cubic-bezier(0.22, 0.9, 0.3, 1);
  }

  .chart-card.is-visible .adapt-svg :global(.bar-rect) {
    transform: scaleY(1);
  }

  .adapt-svg :global(.bar-hit) {
    fill: transparent;
    cursor: pointer;
  }

  .adapt-svg :global(.dim) {
    opacity: 0.22;
    transition: opacity var(--transition-fast);
  }

  @media (prefers-reduced-motion: reduce) {
    .adapt-svg :global(.bar-rect) {
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .adapt-charts {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-adapt]");
  if (root) {
    const dataEl = root.querySelector<HTMLScriptElement>("[data-adapt-data]");
    const data = dataEl ? JSON.parse(dataEl.textContent || "{}") : null;
    const tooltip = root.querySelector<HTMLElement>("[data-adapt-tooltip]")!;

    const showTip = (html: string, x: number, y: number) => {
      tooltip.innerHTML = html;
      tooltip.hidden = false;
      const pad = 14;
      const r = tooltip.getBoundingClientRect();
      const left = Math.min(Math.max(8, x + pad), window.innerWidth - r.width - 8);
      const top = Math.min(Math.max(8, y - r.height - pad), window.innerHeight - r.height - 8);
      tooltip.style.left = `${left}px`;
      tooltip.style.top = `${Math.max(8, top)}px`;
    };
    const hideTip = () => (tooltip.hidden = true);

    const NS = "http://www.w3.org/2000/svg";
    const el = (tag: string, attrs: Record<string, string | number | undefined>) => {
      const n = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(attrs)) {
        if (v === undefined || v === null) continue;
        n.setAttribute(k, String(v));
      }
      return n;
    };

    const INK = "#23201c";
    const ORANGE = "#e8a04f";
    const WAN = "#9a948a";
    const FAINT = "rgba(35,32,28,0.45)";

    /* ================= chart 1: seen-embodiment SSIM curves ================= */
    const seenSvg = root.querySelector<SVGSVGElement>("[data-seen-svg]");
    const seenMeta = root.querySelector<HTMLElement>("[data-seen-meta]");
    if (seenSvg) {
      const W = 560, H = 320, L = 50, R = 14, T = 14, B = 50;
      const iw = W - L - R, ih = H - T - B;
      const Y0 = 0.35, Y1 = 0.78;
      const x = (pct: number) => L + (pct / 100) * iw;
      const y = (v: number) => T + (1 - (v - Y0) / (Y1 - Y0)) * ih;

      // grid + axes (static)
      for (const gv of [0.4, 0.5, 0.6, 0.7]) {
        seenSvg.appendChild(el("line", { x1: L, x2: W - R, y1: y(gv), y2: y(gv), class: "grid-line" }));
        const yTick = el("text", { x: L - 9, y: y(gv) + 4, "text-anchor": "end", class: "axis-text" });
        yTick.textContent = gv.toFixed(1);
        seenSvg.appendChild(yTick);
      }
      for (const gv of [0, 25, 50, 75, 100]) {
        const xTick = el("text", { x: x(gv), y: H - B + 22, "text-anchor": "middle", class: "axis-text" });
        xTick.textContent = `${gv}%`;
        seenSvg.appendChild(xTick);
      }
      const xl = el("text", { x: L + iw / 2, y: H - 6, "text-anchor": "middle", class: "axis-text" });
      xl.textContent = "Training progress (% of final checkpoint)";
      seenSvg.appendChild(xl);
      const yl = el("text", { x: 14, y: T + ih / 2, "text-anchor": "middle", class: "axis-text", transform: `rotate(-90, 14, ${T + ih / 2})` });
      yl.textContent = "Prediction SSIM";
      seenSvg.appendChild(yl);

      const drawFamily = (id: string, animate: boolean) => {
        const fam = data.seen.find((f: any) => f.id === id);
        if (!fam) return;
        seenSvg.querySelectorAll("[data-dynamic]").forEach((n) => n.remove());
        const g = el("g", { "data-dynamic": "1" });
        const line = (vals: number[], color: string, dash: string | null, cls: string) => {
          const d = vals.map((v, i) => `${i ? "L" : "M"} ${x(fam.points[i].pct).toFixed(1)} ${y(v).toFixed(1)}`).join(" ");
          const p = el("path", { d, fill: "none", stroke: color, "stroke-width": 2.5, class: cls });
          if (dash) p.setAttribute("stroke-dasharray", dash);
          if (animate && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            p.setAttribute("pathLength", "1");
            p.style.strokeDasharray = "1";
            p.style.strokeDashoffset = "1";
            p.style.transition = "stroke-dashoffset 1.4s ease-out";
            requestAnimationFrame(() => requestAnimationFrame(() => (p.style.strokeDashoffset = "0")));
          }
          return p;
        };
        g.appendChild(line(fam.points.map((p: any) => p.wan), WAN, null, "curve-wan"));
        g.appendChild(line(fam.points.map((p: any) => p.mix), ORANGE, null, "curve-mix"));
        for (const p of fam.points) {
          g.appendChild(el("circle", { cx: x(p.pct), cy: y(p.wan), r: 3.2, fill: "#fff", stroke: WAN, "stroke-width": 1.6 }));
          g.appendChild(el("circle", { cx: x(p.pct), cy: y(p.mix), r: 3.2, fill: "#fff", stroke: ORANGE, "stroke-width": 1.6 }));
        }
        // hover targets
        for (const p of fam.points) {
          const hit = el("circle", { cx: x(p.pct), cy: y(p.mix), r: 14, fill: "transparent", class: "hit" });
          hit.style.cursor = "pointer";
          hit.addEventListener("mousemove", (e) => {
            showTip(
              `<div class="tt-title">${fam.label}</div>` +
              `<div class="tt-dim">step ${p.step} · ${p.pct}% progress</div>` +
              `<div>MiX-World init <strong>${p.mix.toFixed(3)}</strong></div>` +
              `<div>Wan init <strong>${p.wan.toFixed(3)}</strong> <span class="tt-dim">(Δ +${(p.mix - p.wan).toFixed(3)})</span></div>`,
              e.clientX, e.clientY
            );
          });
          hit.addEventListener("mouseleave", hideTip);
          g.appendChild(hit);
        }
        seenSvg.appendChild(g);
        if (seenMeta) {
          seenMeta.textContent = `${fam.label} · ${fam.validation_episodes} validation ${fam.validation_episodes === 1 ? "episode" : "episodes"}`;
        }
      };

      const seenChips = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-seen-chip]"));
      seenChips.forEach((chip) =>
        chip.addEventListener("click", () => {
          seenChips.forEach((c) => {
            c.classList.toggle("is-active", c === chip);
            c.setAttribute("aria-selected", c === chip ? "true" : "false");
          });
          drawFamily(chip.dataset.seenChip!, true);
        })
      );

      // first draw happens when scrolled into view
      const io1 = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            drawFamily(seenChips[0]?.dataset.seenChip ?? "fixed", true);
            io1.disconnect();
          }
        });
      }, { threshold: 0.35 });
      io1.observe(seenSvg);
    }

    /* ============ chart 2: unseen-embodiment PSNR gain bars ============ */
    const unseenSvg = root.querySelector<SVGSVGElement>("[data-unseen-svg]");
    if (unseenSvg) {
      const W = 560, H = 320, L = 46, R = 14, T = 18, B = 68;
      const iw = W - L - R, ih = H - T - B;
      const YMAX = 5;
      const y = (v: number) => T + (1 - v / YMAX) * ih;

      for (let gv = 0; gv <= YMAX; gv += 1) {
        unseenSvg.appendChild(el("line", { x1: L, x2: W - R, y1: y(gv), y2: y(gv), class: gv === 0 ? "axis-line" : "grid-line" }));
        if (gv % 2 === 0 || gv === YMAX) {
          const t = el("text", { x: L - 9, y: y(gv) + 4, "text-anchor": "end", class: "axis-text" });
          t.textContent = String(gv);
          unseenSvg.appendChild(t);
        }
      }
      const yl = el("text", { x: 14, y: T + ih / 2, "text-anchor": "middle", class: "axis-text", transform: `rotate(-90, 14, ${T + ih / 2})` });
      yl.textContent = "PSNR gain (dB)";
      unseenSvg.appendChild(yl);

      const barW = 34;
      const groupW = iw / data.unseen.length;
      const isolated: Record<string, boolean> = {};

      data.unseen.forEach((body: any, bi: number) => {
        const gx = L + bi * groupW;
        const totalW = body.budgets.length * barW + (body.budgets.length - 1) * 10;
        const start = gx + (groupW - totalW) / 2;
        const grp = el("g", { "data-body": body.id });
        body.budgets.forEach((b: any, j: number) => {
          const bx = start + j * (barW + 10);
          const by = y(b.gain);
          const bar = el("rect", {
            x: bx, y: by, width: barW, height: T + ih - by,
            rx: 4, fill: body.color, class: "bar-rect",
            style: `transition-delay:${(bi * 3 + j) * 70}ms`,
          });
          grp.appendChild(bar);
          const val = el("text", {
            x: bx + barW / 2, y: by - 6, "text-anchor": "middle", class: "bar-value",
          });
          val.textContent = `+${b.gain.toFixed(2)}`;
          grp.appendChild(val);
          // two-line compact budget label: demos number / updates (kept narrow
          // enough that adjacent bars' labels never touch at 13px)
          const upK = b.updates >= 1000 ? `${b.updates / 1000}k` : String(b.updates);
          const l1 = el("text", {
            x: bx + barW / 2, y: H - B + 18, "text-anchor": "middle", class: "axis-text",
            fill: undefined, "font-weight": 500,
          });
          l1.textContent = String(b.demos);
          const l2 = el("text", {
            x: bx + barW / 2, y: H - B + 35, "text-anchor": "middle", class: "axis-text",
            fill: FAINT, "font-size": 11.5,
          });
          l2.textContent = `${upK} up`;
          grp.appendChild(l1);
          grp.appendChild(l2);
          const hit = el("rect", { x: bx - 5, y: T, width: barW + 10, height: ih, class: "bar-hit" });
          hit.addEventListener("mousemove", (e) => {
            showTip(
              `<div class="tt-title">${body.label}</div>` +
              `<div class="tt-dim">${body.env} · ${b.demos} demo(s) · ${b.updates} updates</div>` +
              `<div>Wan init <strong>${b.wan_psnr.toFixed(2)} dB</strong></div>` +
              `<div>MiX-World init <strong>${b.mix_psnr.toFixed(2)} dB</strong></div>` +
              `<div>Gain <strong>+${b.gain.toFixed(2)} dB</strong></div>`,
              e.clientX, e.clientY
            );
          });
          hit.addEventListener("mouseleave", hideTip);
          grp.appendChild(hit);
        });
        unseenSvg.appendChild(grp);
      });

      // legend chips isolate one body (click again to reset)
      const chips = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-unseen-chip]"));
      chips.forEach((chip) =>
        chip.addEventListener("click", () => {
          const id = chip.dataset.unseenChip!;
          isolated[id] = !isolated[id];
          chips.forEach((c) => {
            const on = isolated[c.dataset.unseenChip!] === true;
            c.classList.toggle("is-active", on);
            c.setAttribute("aria-pressed", on ? "true" : "false");
          });
          const any = Object.values(isolated).some(Boolean);
          unseenSvg.querySelectorAll("[data-body]").forEach((g) => {
            g.classList.toggle("dim", any && !isolated[g.getAttribute("data-body")!]);
          });
        })
      );

      const io2 = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            (e.target as HTMLElement).classList.add("is-visible");
            io2.disconnect();
          }
        });
      }, { threshold: 0.35 });
      io2.observe(unseenSvg.closest(".chart-card")!);
    }
  }
</script>
