  "method": {
    "figure_src": "/media/figures/fig2_method_overview_final_web.png",
    "figure_alt": "Paper Figure 2 — MiX-World method overview: (a) shared video diffusion transformer with multiview futures; (b) semantically structured conditioning; (c) event-anchored scheduling; (d) time-anchored RoPE.",
    "caption_draft": "A shared video generator predicts synchronized future views from the current observation, a language instruction, and each robot’s native action sequence.",
    "points": [
      {
        "name": "Semantically Structured Conditioning (SSC)",
        "text": "Organizes robot controls by physical meaning, with masks for the fields each robot uses."
      },
      {
        "name": "Event-Anchored Scheduling (EAS)",
        "text": "Keeps frames around abrupt action changes while sampling trajectories at multiple timescales."
      },
      {
        "name": "Time-Anchored RoPE (TA-RoPE)",
        "text": "Encodes elapsed physical time so predictions account for uneven intervals between sampled frames."
      }
    ]
  },
